{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:scripts": "node bin/build.js --dev",
        "build:scripts": "node bin/build.js",
        "dev:styles": "npx @tailwindcss/cli -i ./resources/css/components/inline-date-time-picker.css -o ./resources/dist/components/inline-date-time-picker.css --watch",
        "build:styles": "npx @tailwindcss/cli -i ./resources/css/components/inline-date-time-picker.css -o ./resources/dist/components/inline-date-time-picker.css --minify",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.6",
        "esbuild": "^0.25.5",
        "prettier": "^3.5.3",
        "npm-run-all": "^4.1.5"
    },
    "dependencies": {
        "dayjs": "^1.11.13"
    }
}
